# MongoDB Database Connection
MONGO_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=Cluster0
DB_NAME=fixmyspot

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_key_in_production
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false

# Initial Administrator Credentials (seeded on first startup)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@fixmyspot.gov
ADMIN_PASSWORD=secure_admin_password_min_8_chars
ADMIN_PASSKEY=change_in_production

# Optional: OpenAI Whisper Speech-to-Text
OPENAI_API_KEY=your_openai_api_key_here
